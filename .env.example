DATABASE_URL=
SESSION_SECRET=
ENCRYPTION_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://api.cordfol.org/api/auth/spotify/callback

# Gmail SMTP (paste the 16-char app password exactly as Google shows it)
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=your@gmail.com
DASHBOARD_URL=https://cordfol.org/dashboard.html

# Welcome + marketing emails send when someone saves/verifies email.
# Blast opted-in users: node scripts/send-marketing.js

# Discord bot (server.js loads bot/index.js)
BOT_TOKEN=
BOT_CLIENT_ID=
CORDFOL_GUILD_ID=0000000000000000000
STATUS_CHANNEL_ID=0000000000000000000
ANNOUNCE_CHANNEL_ID=0000000000000000000
WELCOME_CHANNEL_ID=0000000000000000000
ADMIN_ROLE_IDS=0000000000000000000
STAFF_ROLE_IDS=0000000000000000000
BOT_PREFIX=.
DISCORD_INVITE_URL=https://discord.gg/wcrCgc6pMf

# Ollama AI profile builder (dashboard → AI Builder)
# ollama serve && ollama pull llama3.2
# Optional vision: ollama pull llava  then set OLLAMA_VISION_MODEL=llava
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_VISION_MODEL=llava
# OLLAMA_TIMEOUT_MS=90000

# Tunnel watchdog (cron every minute on astroserver)
# * * * * * /usr/bin/node /home/gfxastro/CordFold/scripts/tunnel-watchdog.js >> /tmp/cordfol-tunnel.log 2>&1
# TUNNEL_SERVICE=cloudflared
# TUNNEL_FAIL_STREAK=2

# Hosted apps (dashboard → Hosted Apps). Works off WiFi via cordfol.org.
# Leave APPS_ALLOWED_DISCORD_IDS empty to let any logged-in user deploy.
# APPS_ALLOWED_DISCORD_IDS=123456789012345678,234567890123456789
# APPS_MAX_PER_USER=3
# APPS_ROOT=/home/gfxastro/data/hosted-apps

# Community ops (Cordfol guild) — auto-created on bot start if empty / missing
# Or run /setup-ops in Discord. Bot needs Manage Channels.
LOG_CHANNEL_ID=
TICKET_CATEGORY_ID=
TICKET_PANEL_CHANNEL_ID=
MODMAIL_CATEGORY_ID=
